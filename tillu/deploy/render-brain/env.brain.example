# ─── TILLU Brain — Render account A ─────────────────────────────────────────
# Copy this file to .env and fill in real values before a local Brain run.
# For Render deployment, set all vars marked "REQUIRED" in the dashboard.
# Never commit a .env file with real secrets.

# ── Identity ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
SERVICE_ROLE=brain
SERVICE_NAME=tillu-brain
BUILD_SHA=                        # injected by Render automatically via sync: false

# ── Owner (REQUIRED) ─────────────────────────────────────────────────────────
OWNER_USER_ID=                    # Heoster's Supabase auth.users UUID
OWNER_EMAIL=heoster.tech@email.com

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Routing / CORS (REQUIRED) ─────────────────────────────────────────────────
CORS_ORIGINS=https://tillu.vercel.app
PUBLIC_APP_URL=https://tillu.vercel.app
RUNTIME_INTERNAL_URL=             # Internal URL of the Runtime service on Render account B

# ── Internal secrets (REQUIRED) ──────────────────────────────────────────────
TILLU_INTERNAL_SECRET=
CRON_SECRET=
RPC_CAPABILITY_SECRET=
BACKUP_ENCRYPTION_KEY=

# ── Honcho memory (REQUIRED for production) ───────────────────────────────────
HONCHO_REQUIRED=true
HONCHO_API_KEY=
HONCHO_BASE_URL=https://api.honcho.dev
HONCHO_WORKSPACE_ID=tillu-heoster
HONCHO_USER_PEER=heoster
HONCHO_ASSISTANT_PEER=tillu
HONCHO_REASONING_LEVEL=medium

# ── AI providers (at least one REQUIRED) ─────────────────────────────────────
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Model selection (defaults are free-tier verified) ─────────────────────────
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_MODEL=gemini-3.1-flash-lite
OPENROUTER_MODEL=openrouter/free
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# ── Web search (optional) ─────────────────────────────────────────────────────
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
YOU_API_KEY=
PARALLEL_API_KEY=
SEARCH_PROVIDER_ORDER=parallel,you,tavily,firecrawl,wikipedia

# ── Operational ───────────────────────────────────────────────────────────────
WEB_CONCURRENCY=1
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
REQUIRE_AI_PROVIDER=true
DEFAULT_LATITUDE=29.97
DEFAULT_LONGITUDE=77.55
