# ─── TILLU Runtime — Render account B ───────────────────────────────────────
# Copy this file to .env and fill in real values before a local Runtime run.
# For Render deployment, set all vars marked "REQUIRED" in the dashboard.
# Never commit a .env file with real secrets.

# ── Identity ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
SERVICE_ROLE=runtime
SERVICE_NAME=tillu-runtime
BUILD_SHA=                        # injected by Render automatically via sync: false

# ── Owner (REQUIRED) ─────────────────────────────────────────────────────────
OWNER_USER_ID=                    # Heoster's Supabase auth.users UUID
OWNER_EMAIL=heoster.tech@email.com

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Routing / CORS (REQUIRED) ─────────────────────────────────────────────────
CORS_ORIGINS=https://tillu.vercel.app
PUBLIC_APP_URL=https://tillu.vercel.app

# ── Internal secrets (REQUIRED) ──────────────────────────────────────────────
TILLU_INTERNAL_SECRET=            # Must match the Brain service's TILLU_INTERNAL_SECRET
CRON_SECRET=
BACKUP_ENCRYPTION_KEY=

# ── Browser (REQUIRED in production) ─────────────────────────────────────────
BROWSER_HEADLESS=true

# ── PWA push notifications (optional) ────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:heoster@example.com

# ── Optional integrations ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Operational ───────────────────────────────────────────────────────────────
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
DEFAULT_LATITUDE=29.97
DEFAULT_LONGITUDE=77.55
