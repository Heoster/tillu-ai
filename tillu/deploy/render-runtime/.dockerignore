# Exclude noise from the build context — works for both:
#   Root Directory = deploy/render-runtime  (context = that folder)
#   Root Directory = (repo root)            (context = entire repo)

**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.venv
*.db
*.sqlite
.env
.env.*
!.env.example
library
browser-artifacts
tests
.DS_Store
Thumbs.db
*.swp
*.swo
# Exclude the Electron browser app and other workspace noise from repo-root builds
tillu-browser
.agents
.kiro
apps/desktop
apps/web
