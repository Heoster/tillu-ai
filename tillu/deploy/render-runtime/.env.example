ENVIRONMENT=development
# Production roles are brain or runtime. Separate Render services may share this image.
SERVICE_ROLE=brain
SERVICE_NAME=tillu-brain
BUILD_SHA=development
RUNTIME_INTERNAL_URL=
TILLU_INTERNAL_SECRET=
# Required on the production Brain. Managed Honcho defaults to api.honcho.dev.
HONCHO_REQUIRED=true
HONCHO_API_KEY=
HONCHO_BASE_URL=https://api.honcho.dev
HONCHO_WORKSPACE_ID=tillu-heoster
HONCHO_USER_PEER=heoster
HONCHO_ASSISTANT_PEER=tillu
HONCHO_REASONING_LEVEL=medium
# Development/test only. Production requires Supabase Postgres.
SQLITE_PATH=./tillu_local.db
# Fail closed instead of emitting model-like fallback answers when no hosted provider is configured.
REQUIRE_AI_PROVIDER=true
# Production security material (use independent random values; never commit them).
RPC_CAPABILITY_SECRET=
BACKUP_ENCRYPTION_KEY=
# TILLU is private. In production set one or both to Heoster's Supabase account.
# Required in production: Heoster's auth.users UUID. Email alone is not sufficient.
OWNER_USER_ID=5131392a-7d6e-4760-b504-c4fe2351e087
OWNER_EMAIL=heoster.tech@email.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Curated free/free-tier defaults verified against official provider documentation.
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_MODEL=gemini-3.1-flash-lite
OPENROUTER_MODEL=openrouter/free
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
CRON_SECRET=
DEFAULT_LATITUDE=29.97
DEFAULT_LONGITUDE=77.55
YOU_API_KEY=
PARALLEL_API_KEY=
SEARCH_PROVIDER_ORDER=parallel,you,tavily,firecrawl,wikipedia

# Optional Jarvis-style integrations (backend only).
# Leave these blank to disable the corresponding integration; TILLU still starts and works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
BROWSER_HEADLESS=true
# Optional PWA Web Push delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:heoster@example.com
