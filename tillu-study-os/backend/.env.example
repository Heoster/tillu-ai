# ─────────────────────────────────────────────────────────────────────────────
# Tillu AI Study OS — backend environment template
# Copy this file to .env and fill in the values marked below.
# See SETUP.md at the project root for step-by-step instructions.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AI providers (required) ──────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key

# ── Server ports ─────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_NIGHTLY_HOUR=22
SCHEDULER_NIGHTLY_MINUTE=0

# ── Sleep defaults (HH:MM) ───────────────────────────────────────────────────
DEFAULT_SLEEP_START=23:00
DEFAULT_SLEEP_END=06:00

# ── Phase 4 — Voice interaction (optional) ───────────────────────────────────
# Get a key at: dashboard.sarvam.ai
# Set SARVAM_ENABLED=true to activate the microphone button on the dashboard.
SARVAM_API_KEY=
SARVAM_ENABLED=false

# ── Phase 6 — RAG document search with pgvector (optional) ──────────────────
# Set RAG_ENABLED=true to activate document upload and vector similarity search.
# Requires the match_documents RPC function (migration 003_rag_rpc.sql) applied
# in Supabase.
RAG_ENABLED=false

# ── Phase 6 — Parallel Search MCP (optional) ─────────────────────────────────
# Set PARALLEL_MCP_ENABLED=true after configuring the MCP server endpoint.
PARALLEL_MCP_ENABLED=false
